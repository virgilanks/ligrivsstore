{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ligrivsstore",
  "version": "0.1.0",
  "identifier": "com.ligrivs.ligrivsstore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ligrivsstore",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "principale"
      ],
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ligrivs",
    "copyright": "© 2026 ligrivs",
    "category": "Utility",
    "shortDescription": "Gestionnaire de mots de passe",
    "longDescription": "ligrivsstore garde vos mots de passe dans un coffre chiffré (format KDBX 4), sur ce PC, et le synchronise avec votre serveur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/ligrivsstore-pont"
    ],
    "resources": {
      "native-host/com.ligrivs.ligrivsstore.json": "com.ligrivs.ligrivsstore.json"
    }
  }
}
