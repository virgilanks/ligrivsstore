# coffre — paramètres du déploiement (aucun secret)
# Copier en .env (droits 600) et compléter les valeurs « a_attribuer ».

# Nom public (sous-domaine de ligrivs.com, DNS géré par Cloudflare)
PUBLIC_HOSTNAME=coffre.ligrivs.com

# Adresse d'edge01 (DMZ) : seul relais dont l'en-tête X-Forwarded-For est cru
EDGE01_IP=a_attribuer

# Port publié sur coffre01 (8080 à 8099), attribué au déploiement
PORT_HTTP=a_attribuer

# Historique des coffres : un passage toutes les 15 minutes, conservation 30 jours
SNAPSHOT_INTERVAL=900
RETENTION_DAYS=30
