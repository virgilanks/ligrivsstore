{
  "manifest_version": 3,
  "name": "ligrivsstore",
  "version": "0.1.0",
  "description": "Propose, sur les pages de connexion, les identifiants de votre coffre ligrivsstore.",
  "key": "",
  "minimum_chrome_version": "133",
  "permissions": ["nativeMessaging", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ligrivsstore",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
